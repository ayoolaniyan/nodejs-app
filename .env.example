# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=8080

# Prisma reads DATABASE_URL directly; set it as one value rather than
# assembling it at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/customers?schema=public&sslmode=prefer"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/customers?schema=dbmigration&sslmode=prefer"

# Must be two different secrets: sharing one means a refresh token is
# accepted anywhere an access token is. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
